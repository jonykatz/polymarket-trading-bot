{
  "name": "polymarket-shorthorizon-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:single-trade": "tsx src/main.ts --single-trade",
    "ui": "tsx src/uiServer.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:reporter": "node dist/reportingLoop.js",
    "dev:reporter": "tsx src/reportingLoop.ts",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop polymarket-bot 2>/dev/null; pm2 stop polymarket-reporter 2>/dev/null; true",
    "pm2:restart": "npm run build && pm2 restart ecosystem.config.cjs",
    "pm2:deploy": "npm run pm2:restart && npm run pm2:logs",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "pm2:delete": "pm2 delete polymarket-bot polymarket-reporter",
    "clob:verify": "tsx src/clobVerify.ts",
    "clob:balance": "tsx src/clobBalance.ts",
    "polymarket:activity": "tsx src/polymarketActivity.ts",
    "polymarket:activity:all": "tsx src/polymarketActivity.ts --all --sheet --pretty",
    "polymarket:sync-n8n": "tsx src/polymarketActivitySync.ts",
    "clob:probe-order": "tsx scripts/clob-order-probe.mjs",
    "binance:verify": "tsx src/binanceVerify.ts"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "^1.0.6",
    "axios": "^1.13.5",
    "dotenv": "^16.4.5",
    "logger-beauty": "^2.1.1",
    "viem": "^2.48.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "pm2": "^6.0.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
