POLYMARKET_REST_BASE=https://gamma-api.polymarket.com
POLYMARKET_DATA_API_BASE=https://data-api.polymarket.com
BINANCE_REST_BASE=https://fapi.binance.com
# Set false to skip Binance in features (btcScore stays 0).
BINANCE_FEATURES_ENABLED=true
# Reuse last successful BTC snapshot for this many seconds; on REST failure (e.g. 429) use stale cache.
BINANCE_SNAPSHOT_TTL_SEC=60

PAPER_MODE=true
# n8n webhook (production URL when workflow is active): events → Google Sheets
WEBHOOK_URL=

PRIVATE_KEY=your_private_key
CLOB_API_URL=https://clob.polymarket.com
CLOB_CHAIN_ID=137
# EOA = MetaMask/hardware wallet. Legacy email login = POLY_PROXY or POLY_GNOSIS_SAFE. New deposit wallets = POLY_1271.
CLOB_SIGNATURE_TYPE=POLY_1271
CLOB_FUNDER_ADDRESS=

CLOSE_AFTER_SECONDS=0

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

LOOP_SECONDS=15
MAX_POSITION_USD=100
EDGE_THRESHOLD=0.03
CONFIDENCE_THRESHOLD=0.80
# Live buy only: added to tick quote for CLOB price limit (capped at ENTRY_PRICE_MAX 0.95).
ENTRY_SLIPPAGE=0.05
# Min seconds left in the 5m window before opening a new live position (default 60).
MIN_REMAINING_SEC_ENTRY=60
# Sell when captured gain ≥ this fraction of max upside (1 − entry). 0.70 = 70%.
TAKE_PROFIT_PCT_OF_MAX=0.70
# Stop loss: sell when mark ≤ entry × (1 − this). 0.25 = 25% below entry.
STOP_LOSS_PCT=0.25
# Near expiry: force-sell losers only when remainingSec ≤ this (+ LOOP_SECONDS). Winners hold for settlement.
FORCE_EXIT_SECONDS=45
# Min ms after BUY before evaluating take profit / stop loss (token settlement).
MIN_POSITION_AGE_MS=30000
# Ms to wait after buy/sell/settle before reading CLOB USDC for fees/PnL (default 8000 = 8s).
BALANCE_SETTLE_DELAY_MS=8000
# Activity reporter: polls Polymarket /activity → n8n → Google Sheets
ACTIVITY_POLL_SECONDS=30
ACTIVITY_POLL_LIMIT=5
ACTIVITY_POLL_SEED_ON_START=true
N8N_SYNC_DELAY_MS=4000
# Reconcile .data/open-positions.json vs Data API GET /positions (live only).
POSITION_RECONCILE_ENABLED=true
POSITION_RECONCILE_SECONDS=120
POSITION_SIZE_EPS=0.05
POSITION_RECONCILE_SIZE_THRESHOLD=0.01
EMA_FAST=5
EMA_SLOW=13
RSI_PERIOD=14
WHALE_MIN_WINRATE=0.70
WHALE_MIN_NOTIONAL=200
WALLET_WINRATE_TIMEOUT_MS=3000
WALLET_WINRATE_CACHE_TTL_SEC=600
