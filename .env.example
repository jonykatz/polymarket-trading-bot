POLYMARKET_REST_BASE=https://gamma-api.polymarket.com
POLYMARKET_DATA_API_BASE=https://data-api.polymarket.com
BINANCE_REST_BASE=https://fapi.binance.com
# Set false to skip Binance in features (btcScore stays 0).
BINANCE_FEATURES_ENABLED=true
# Reuse last successful BTC snapshot for this many seconds; on REST failure (e.g. 429) use stale cache.
BINANCE_SNAPSHOT_TTL_SEC=60

PAPER_MODE=true
WEBHOOK_URL=

PRIVATE_KEY=your_private_key
CLOB_API_URL=https://clob.polymarket.com
CLOB_CHAIN_ID=137
# EOA = MetaMask/hardware wallet. Legacy email login = POLY_PROXY or POLY_GNOSIS_SAFE. New deposit wallets = POLY_1271.
CLOB_SIGNATURE_TYPE=POLY_1271
CLOB_FUNDER_ADDRESS=

CLOSE_AFTER_SECONDS=0

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

LOOP_SECONDS=15
MAX_POSITION_USD=100
EDGE_THRESHOLD=0.03
CONFIDENCE_THRESHOLD=0.80
FORCE_EXIT_SECONDS=3
EMA_FAST=5
EMA_SLOW=13
RSI_PERIOD=14
WHALE_MIN_WINRATE=0.70
WHALE_MIN_NOTIONAL=200
WALLET_WINRATE_TIMEOUT_MS=3000
WALLET_WINRATE_CACHE_TTL_SEC=600
